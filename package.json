{
  "name": "goblin-game",
  "private": true,
  "license": "SEE LICENSE IN NOTICE.md",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "package": "bun run build && rm -f poki-build.zip && cd dist && zip -qr ../poki-build.zip . -x elf-preview.html 'assets/elfPreview-*'",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:elf": "node tools/validate-glb.mjs public/models/elf/elf.glb --expect-anims Idle,Walk,Run,Play,Cast,Strike,Capture,Victory,Stunned --expect-nodes prop_harp,ElfMesh_LOD0,ElfMesh_LOD1"
  },
  "dependencies": {
    "@poki/netlib": "0.0.20",
    "shaders": "^4.0.4",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "3.2.4",
    "vue-tsc": "^3.3.13"
  }
}
